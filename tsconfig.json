{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "removeComments": true,
    "stripInternal": true,
    "resolveJsonModule": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@variousjs/various": ["./src/public/index.ts"],
      "@variousjs/various/standalone": ["./src/public/standalone.ts"]
    }
  },
  "exclude": ["dist", "public"]
}
