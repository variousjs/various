{
  "name": "@variousjs/various",
  "version": "6.0.2",
  "type": "module",
  "description": "React-based ESM micro-frontend framework",
  "files": [
    "dist",
    "index.d.ts",
    "standalone.d.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./standalone": {
      "import": {
        "types": "./standalone.d.ts",
        "default": "./dist/standalone.mjs"
      },
      "require": {
        "types": "./standalone.d.ts",
        "default": "./dist/standalone.js"
      }
    }
  },
  "unpkg": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "nyc": {
    "exclude": [
      "test/*",
      "cypress/*"
    ],
    "excludeAfterRemap": true
  },
  "scripts": {
    "lint": "tsc --noemit --skipLibCheck && eslint . --ext .ts,.tsx,.js",
    "create-empty": "echo 'export {}' > public/dist/empty.js",
    "dev:core": "TARGET=core vite build --watch --mode development",
    "dev:loader": "TARGET=loader vite build --watch --mode development",
    "dev:standalone": "TARGET=standalone-dev vite build --watch --mode development",
    "dev:components": "TARGET=components vite build --watch --mode development",
    "dev:serve": "TARGET=serve vite --mode development",
    "_dev-all": "npm run dev:core & npm run dev:loader & npm run dev:standalone & npm run dev:components & npm run dev:serve",
    "prestart": "mkdir -p public/dist && npm run create-empty",
    "start": "npm run _dev-all",
    "prestart:ci": "mkdir -p public/dist && npm run create-empty",
    "start:ci": "COVERAGE=1 npm run _dev-all",
    "build:core": "TARGET=core vite build && cp dist/index.js public/dist/index.js",
    "build:core:dev": "TARGET=core DEV_VARIANT=true vite build --mode development",
    "build:loader": "TARGET=loader vite build && cp dist/loader.js public/dist/loader.js",
    "build:loader:dev": "TARGET=loader DEV_VARIANT=true vite build --mode development",
    "build:standalone": "TARGET=standalone vite build --mode development",
    "build:standalone:esm": "TARGET=standalone-esm vite build --mode development",
    "build:components": "TARGET=components vite build",
    "build": "npm run build:core && npm run build:core:dev && npm run build:loader && npm run build:loader:dev && npm run build:standalone && npm run build:standalone:esm && npm run build:components",
    "prebuild": "npm run lint && rm -rf dist && rm -rf public/dist && mkdir -p public/dist",
    "postbuild": "npm run create-empty",
    "prepublishOnly": "npm run build",
    "cy:run": "rm -rf .nyc_output coverage && cypress run",
    "ci": "start-server-and-test start:ci http://127.0.0.1:2333 cy:run",
    "cypress": "cypress open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/variousjs/various.git"
  },
  "keywords": [
    "esm",
    "micro-frontend",
    "react"
  ],
  "author": "LoeiFy <LoeiFy@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/variousjs/various/issues"
  },
  "homepage": "https://github.com/variousjs/various#readme",
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "cypress": "^15.19.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "start-server-and-test": "^3.0.11",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-istanbul": "^9.0.1",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "nycticorax": "^4.2.1"
  }
}
